---
import Icon from './Icon.astro';
import { site } from '../data/site';

const { reviews, address, placeType, maps, rights } = site;
const starFill = `${Math.round((reviews.rating / 5) * 100)}%`;
const reviewsHref = maps.share;
---

<section class="review-card" aria-labelledby="review-title">
  <div class="review-grid">
    <div>
      <p class="review-eyebrow">旅客評價</p>
      <h2 id="review-title" class="review-title">旅客怎麼評價觀夕平台</h2>

      <div class="review-score">
        <strong>{reviews.ratingLabel}</strong>
        <div>
          <span class="review-stars" aria-hidden="true">
            <span class="review-stars-fill" style={`width:${starFill}`}>★★★★★</span>
            <span class="review-stars-base">★★★★★</span>
          </span>
          <p class="review-count">依 {reviews.countLabel} 則 Google 地圖評價計算的平均分數</p>
        </div>
      </div>

      <dl class="review-facts">
        <div>
          <dt>景點類型</dt>
          <dd>{placeType}</dd>
        </div>
        <div>
          <dt>評分來源</dt>
          <dd>{reviews.source}</dd>
        </div>
        <div>
          <dt>評價同步時間</dt>
          <dd>{reviews.syncedAt}</dd>
        </div>
        <div>
          <dt>地點</dt>
          <dd>{address}</dd>
        </div>
      </dl>
    </div>

    <div class="review-side">
      <p class="review-side-lead">
        本站僅同步顯示評分與評價數量，不轉載個別評論文字；如需閱讀完整內容，請直接前往 Google 地圖。
      </p>
      <a class="button review-button" href={reviewsHref} target="_blank" rel="noopener noreferrer">
        <Icon name="map" class="size-[18px]" />
        {reviews.cta}
      </a>
      <a class="review-share" href={maps.share} target="_blank" rel="noopener noreferrer">
        以 Google 地圖分享連結開啟
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>

  <p class="review-note">{reviews.note}</p>
  <a class="review-inline-note" href={reviewsHref} target="_blank" rel="noopener noreferrer">
    {reviews.inlineNote}
  </a>
  <p class="review-rights">{rights.photos}</p>
</section>

<style>
  .review-card {
    padding: 1.6rem;
    border: 1px solid rgb(23 59 63 / 12%);
    border-radius: 1.6rem;
    background: rgb(255 255 255 / 78%);
    box-shadow: 0 18px 44px rgb(23 59 63 / 9%);
  }

  .review-grid {
    display: grid;
    gap: 1.6rem;
  }

  .review-eyebrow {
    color: #2e6f73;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .review-title {
    margin-top: 0.55rem;
    color: #173b3f;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.25;
  }

  .review-score {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 1.35rem;
  }

  .review-score > strong {
    color: #173b3f;
    font-size: clamp(2.6rem, 6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .review-stars {
    position: relative;
    display: inline-block;
    color: rgb(23 59 63 / 18%);
    font-size: 1.15rem;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .review-stars-base,
  .review-stars-fill {
    display: block;
    white-space: nowrap;
  }

  .review-stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    color: #e98a4a;
  }

  .review-count {
    margin: 0.25rem 0 0;
    color: rgb(23 59 63 / 58%);
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .review-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 1.5rem 0 0;
  }

  .review-facts div {
    padding: 0.8rem 0.9rem;
    border-radius: 0.9rem;
    background: #f6f0e4;
  }

  .review-facts dt {
    color: rgb(23 59 63 / 52%);
    font-size: 0.68rem;
  }

  .review-facts dd {
    margin: 0.2rem 0 0;
    color: #173b3f;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .review-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.85rem;
    padding: 1.2rem;
    border: 1px solid rgb(46 111 115 / 18%);
    border-radius: 1.15rem;
    background: rgb(46 111 115 / 6%);
  }

  .review-side-lead {
    margin: 0;
    color: rgb(23 59 63 / 68%);
    font-size: 0.8rem;
    line-height: 1.8;
  }

  .review-button {
    background: #e98a4a;
    color: #172a3a;
  }

  .review-button:hover {
    background: #f3a06a;
  }

  .review-share {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #2e6f73;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .review-share:hover {
    color: #173b3f;
  }

  .review-note {
    margin: 1.4rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(23 59 63 / 10%);
    color: rgb(23 59 63 / 58%);
    font-size: 0.74rem;
    line-height: 1.75;
  }

  .review-inline-note {
    display: block;
    margin-top: 0.35rem;
    color: rgb(23 59 63 / 62%);
    font-size: 0.72rem;
    line-height: 1.7;
    text-decoration: underline;
    text-decoration-color: rgb(46 111 115 / 25%);
    text-underline-offset: 0.22em;
  }

  .review-inline-note:hover {
    color: #2e6f73;
    text-decoration-color: #2e6f73;
  }

  .review-rights {
    margin: 0.5rem 0 0;
    color: rgb(23 59 63 / 45%);
    font-size: 0.68rem;
    line-height: 1.7;
  }

  @media (min-width: 900px) {
    .review-card {
      padding: 2.1rem;
    }

    .review-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
      gap: 2rem;
    }
  }

  @media (max-width: 520px) {
    .review-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
