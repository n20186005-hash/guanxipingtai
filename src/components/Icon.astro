---
interface Props {
  name:
    | 'arrow'
    | 'car'
    | 'clock'
    | 'compass'
    | 'map'
    | 'menu'
    | 'route'
    | 'shield'
    | 'sparkles'
    | 'sun'
    | 'transit'
    | 'walk'
    | 'wave';
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', strokeWidth = 1.8 } = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  car: '<path d="m5 17-1 2m15-2 1 2M3 13l2-6h14l2 6v5H3z"/><circle cx="7" cy="16" r="1"/><circle cx="17" cy="16" r="1"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15 9-2 4-4 2 2-4z"/>',
  map: '<path d="m3 6 5-2 8 3 5-2v13l-5 2-8-3-5 2zM8 4v13m8-10v13"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  route: '<circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M8 18h3a3 3 0 0 0 0-6h2a3 3 0 0 0 3-3V8"/>',
  shield: '<path d="M12 3 5 6v5c0 4.5 2.8 8 7 10 4.2-2 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/>',
  sparkles: '<path d="m12 3 1.2 3.8L17 8l-3.8 1.2L12 13l-1.2-3.8L7 8l3.8-1.2zM5 15l.8 2.2L8 18l-2.2.8L5 21l-.8-2.2L2 18l2.2-.8zM18 14l.8 2.2L21 17l-2.2.8L18 20l-.8-2.2L15 17l2.2-.8z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  transit: '<rect x="5" y="3" width="14" height="16" rx="3"/><path d="M5 8h14M8 16h.01M16 16h.01M8 21l1-2m7 2-1-2"/>',
  walk: '<circle cx="13" cy="4" r="2"/><path d="m11 8-2 5 4 2 2 6m-6-8-4 7m6-12 4 3 4-1"/>',
  wave: '<path d="M3 8c3-3 6-3 9 0s6 3 9 0M3 14c3-3 6-3 9 0s6 3 9 0M3 20c3-3 6-3 9 0s6 3 9 0"/>'
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
