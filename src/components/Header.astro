---
import Icon from './Icon.astro';
import { primaryNavigation, site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell flex h-[72px] items-center justify-between gap-5">
    <a href="/" class="brand-link" aria-label={`${site.fullName}首頁`}>
      <span class="brand-mark" aria-hidden="true">
        <span class="brand-sun"></span>
        <span class="brand-wave"></span>
      </span>
      <span>
        <strong class="block text-[1.05rem] tracking-[.12em] text-white">觀夕平台</strong>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="主要導覽">
      {
        primaryNavigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link',
              currentPath === item.href && 'nav-link-active'
            ]}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      class="button button-sunset header-map-button"
      href={site.maps.place}
      target="_blank"
      rel="noreferrer"
    >
      <Icon name="map" class="size-[18px]" />
      開啟地圖
    </a>

    <details class="mobile-menu relative lg:hidden">
      <summary class="icon-button">
        <span class="sr-only">開啟導覽選單</span>
        <Icon name="menu" class="size-6" />
      </summary>
      <div class="absolute right-0 top-[52px] z-50 w-[min(86vw,320px)] rounded-2xl border border-white/10 bg-[#173b3f] p-3 shadow-2xl">
        <nav class="flex flex-col" aria-label="行動版導覽">
          {
            primaryNavigation.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded-xl px-4 py-3 text-sm text-white/75 hover:bg-white/10 hover:text-white',
                  currentPath === item.href && 'bg-white/10 text-white'
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={site.maps.place}
            target="_blank"
            rel="noreferrer"
            class="button button-sunset mt-2 justify-center"
          >
            <Icon name="map" class="size-[18px]" />
            開啟 Google 地圖
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>
