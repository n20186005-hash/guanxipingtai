---
import inlineStyles from '../styles/global.css?inline';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileDock from '../components/MobileDock.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: object | object[];
  mapUrl?: string;
}

const {
  title = '觀夕平台攻略｜台南安平今日夕陽時間、停車場、公車與地圖',
  description = site.description,
  image = '/guanxipingtai-social-cover-1.jpg',
  imageAlt = '觀夕平台（觀夕平臺）在臺南安平的海岸與日落景觀',
  type = 'website',
  noindex = false,
  structuredData,
  mapUrl
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).toString();
const absoluteImage = new URL(image, site.url).toString();
const jsonLd = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="zh-Hant-TW" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#173b3f" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <style is:global set:html={inlineStyles} />

    <meta name="application-name" content={site.fullName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />

    <script is:inline>
      // 分析工具僅在訪客主動同意後載入，拒絕或未選擇時不寫入分析 Cookie。
      window.enableSiteAnalytics = function () {
        if (window.siteAnalyticsLoaded) return;
        window.siteAnalyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-HXM22WWPKP');
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';
        document.head.appendChild(script);
      };
      try {
        if (localStorage.getItem('guanxipingtai-cookie-consent') === 'accepted') {
          window.enableSiteAnalytics();
        }
      } catch (_) { /* 儲存空間停用時不啟用分析 */ }
    </script>

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳至主要內容</a>
    <Header mapUrl={mapUrl} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileDock mapUrl={mapUrl} />
    <script is:inline>
      // Recover a stylesheet if an older service worker has cached a transient 404.
      window.addEventListener('load', () => {
        document.querySelectorAll('link[rel="stylesheet"]').forEach((link) => {
          if (link.sheet || link.dataset.retriedCss) return;
          link.dataset.retriedCss = 'true';
          const url = new URL(link.href, location.href);
          url.searchParams.set('recover', '3');
          link.href = url.toString();
        });
      });
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          // A versioned script URL ensures previously cached 404 assets are evicted promptly.
          navigator.serviceWorker.register('/sw.js?v=3').catch(() => {});
        });
      }
    </script>
  </body>
</html>
