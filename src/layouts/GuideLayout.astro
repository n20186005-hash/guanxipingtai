---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MapActions from '../components/MapActions.astro';
import SafetyAlert from '../components/SafetyAlert.astro';
import StatusNotice from '../components/StatusNotice.astro';
import { allGuides, faqItems, site } from '../data/site';

interface Props {
  entry: CollectionEntry<'guides'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const data = entry.data;
const slug = entry.id.replace(/\.mdx?$/, '');
const relatedGuides = data.related
  .map((relatedSlug) => allGuides.find((guide) => guide.href === `/${relatedSlug}/`))
  .filter(Boolean);
const h2s = headings.filter((heading) => heading.depth === 2);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: 'zh-Hant-TW',
  dateModified: data.updatedAt.toISOString(),
  mainEntityOfPage: `${site.url}/${slug}/`,
  publisher: {
    '@type': 'Organization',
    name: site.fullName,
    url: site.url
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首頁',
      item: site.url
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: data.title,
      item: `${site.url}/${slug}/`
    }
  ]
};

const schemas: object[] = [articleSchema, breadcrumbSchema];
if (slug === 'faq') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer
      }
    }))
  });
}
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  type="article"
  structuredData={schemas}
>
  <header class:list={['guide-hero', `guide-hero-${data.accent}`]}>
    <div class="guide-orb" aria-hidden="true"></div>
    <div class="shell relative z-10 py-14 sm:py-20">
      <nav class="breadcrumb" aria-label="麵包屑">
        <a href="/">首頁</a>
        <span aria-hidden="true">／</span>
        <span>{data.category}</span>
      </nav>
      <h1 class="mt-8 max-w-4xl text-balance text-[clamp(2.25rem,6vw,4.8rem)] font-semibold leading-[1.08] tracking-[-.045em] text-white">
        {data.title}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-white/72 sm:text-lg">
        {data.intro}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4 text-xs text-white/55">
        <span class="inline-flex items-center gap-2">
          <Icon name="compass" class="size-4" />
          旅遊實用指南
        </span>
        <span aria-hidden="true">•</span>
        <span>內容檢視：{data.updatedAt.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long' })}</span>
      </div>
    </div>
  </header>

  <div class="shell grid gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_280px] lg:py-20">
    <article class="min-w-0">
      {data.volatileInformation && <StatusNotice />}
      <div class="article-content">
        <slot />
      </div>
      {slug !== 'safety' && <SafetyAlert condensed />}
      {data.showMapActions && (
        <section class="mt-10 rounded-[1.75rem] bg-[#173b3f] p-6 text-white sm:p-8">
          <h2 class="text-2xl font-semibold">把下一步交給地圖</h2>
          <p class="mt-3 max-w-xl text-sm leading-7 text-white/65">
            直接開啟目的地或選擇交通方式。公車與路況可能變動，出發前請再確認即時資訊。
          </p>
          <div class="mt-6">
            <MapActions compact />
          </div>
        </section>
      )}

      {relatedGuides.length > 0 && (
        <section class="mt-12 border-t border-[#173b3f]/12 pt-10">
          <h2 class="text-2xl font-semibold text-[#173b3f]">接著安排旅程</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {relatedGuides.map((guide) => guide && (
              <a class="related-card" href={guide.href}>
                <span>
                  <strong>{guide.label}</strong>
                  <small>{guide.description}</small>
                </span>
                <Icon name="arrow" class="size-5 shrink-0" />
              </a>
            ))}
          </div>
        </section>
      )}
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-[96px] rounded-2xl border border-[#173b3f]/10 bg-white/70 p-5">
        <p class="text-xs font-bold tracking-[.14em] text-[#2e6f73]">本頁內容</p>
        <nav class="mt-4 flex flex-col" aria-label="文章目錄">
          {
            h2s.map((heading) => (
              <a class="toc-link" href={`#${heading.slug}`}>{heading.text}</a>
            ))
          }
        </nav>
      </div>
    </aside>
  </div>
</BaseLayout>
