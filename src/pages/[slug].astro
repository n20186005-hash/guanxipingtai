---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => data.reviewStatus === 'reviewed');
  return guides.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = entry.id.replace(/\.mdx?$/, '');

const faq =
  slug === 'faq'
    ? (entry.body ?? '')
        .split(/\n(?=##\s)/)
        .map((block) => block.trim())
        .filter((block) => block.startsWith('## '))
        .map((block) => {
          const [headingLine, ...rest] = block.split('\n');
          return {
            question: headingLine.replace(/^##\s+/, '').trim(),
            answer: rest.join(' ').replace(/\s+/g, ' ').trim()
          };
        })
        .filter((item) => item.question.length > 0 && item.answer.length > 0)
    : [];
---

<GuideLayout entry={entry} headings={headings} faq={faq}>
  <Content />
</GuideLayout>
