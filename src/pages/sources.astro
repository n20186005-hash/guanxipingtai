---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const sourceGroups = [
  {
    title: '地點與交通',
    items: [
      ['Google 地圖', site.maps.place],
      ['大台南公車', 'https://2384.tainan.gov.tw/'],
      ['台灣好行', 'https://www.taiwantrip.com.tw/'],
      ['臺南旅遊網', 'https://www.twtainan.net/']
    ]
  },
  {
    title: '天氣與安全',
    items: [
      ['中央氣象署', 'https://www.cwa.gov.tw/'],
      ['交通部觀光署', 'https://www.taiwan.net.tw/'],
      ['臺南市政府', 'https://www.tainan.gov.tw/']
    ]
  }
];

const photoCredits = [
  {
    file: 'guanxipingtai-hero-sunset-1.jpg',
    original: '安平商港北堤',
    use: '首頁主視覺',
    author: 'Guanting Chen',
    license: 'CC BY-SA 4.0',
    url: 'https://commons.wikimedia.org/wiki/File:%E5%AE%89%E5%B9%B3%E5%95%86%E6%B8%AF%E5%8C%97%E5%A0%A4.jpg'
  },
  {
    file: 'guanxipingtai-coast-platform-1.jpg',
    original: 'Sunset Platform',
    use: '觀夕平台海岸實景',
    author: 'ScoutT7',
    license: 'CC BY-SA 4.0',
    url: 'https://commons.wikimedia.org/wiki/File:Sunset_Platform.jpg'
  },
  {
    file: 'anping-old-street-food-1.jpg',
    original: 'Anping Old Street',
    use: '附近景點・安平老街',
    author: 'Chongkian',
    license: 'CC BY-SA 4.0',
    url: 'https://commons.wikimedia.org/wiki/File:Anping_Old_Street.jpg'
  },
  {
    file: 'anping-tree-house-banyan-1.jpg',
    original: '2015-05-01 Anping Tree House 01',
    use: '附近景點・安平樹屋',
    author: 'Sun Taro',
    license: 'CC BY-SA 2.0',
    url: 'https://commons.wikimedia.org/wiki/File:2015-05-01_Anping_Tree_House_01.jpg'
  },
  {
    file: 'anping-market-snack-1.jpg',
    original: 'Food for sale on Anping Old Street',
    use: '周邊美食',
    author: 'Mx. Granger',
    license: 'CC0',
    url: 'https://commons.wikimedia.org/wiki/File:Food_for_sale_on_Anping_Old_Street.jpg'
  }
];
---

<BaseLayout
  title="資料來源與圖片授權｜觀夕平台旅遊指南"
  description="觀夕平台旅遊指南的交通、天氣、安全資料來源，以及網站使用之安平實景圖片授權與攝影者資訊。"
>
  <header class="guide-hero guide-hero-sea">
    <div class="shell relative z-10 py-16 sm:py-24">
      <nav class="breadcrumb" aria-label="麵包屑">
        <a href="/">首頁</a><span aria-hidden="true">／</span><span>資料來源</span>
      </nav>
      <h1 class="mt-8 max-w-4xl text-balance text-[clamp(2.4rem,7vw,5rem)] font-semibold leading-[1.06] tracking-[-.05em] text-white">
        資料來源與圖片授權
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-white/68">
        旅遊資訊依穩定度選擇來源；實景照片均保留作者、授權條款與原始檔案頁面。
      </p>
    </div>
  </header>

  <div class="shell py-16 sm:py-24">
    <section>
      <h2 class="text-3xl font-semibold tracking-[-.035em] text-[#173b3f]">旅遊資訊查核原則</h2>
      <p class="section-lead mt-5">
        現場最新公告優先，其次為景點管理單位、臺南市政府、交通營運單位與中央氣象署。地圖近期資訊用於補充旅客現場觀察，不取代交通或安全公告。
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          sourceGroups.map((group) => (
            <div class="rounded-2xl border border-[#173b3f]/10 bg-white/60 p-6">
              <h3 class="font-semibold text-[#173b3f]">{group.title}</h3>
              <div class="mt-4 flex flex-col">
                {group.items.map(([label, url]) => (
                  <a
                    class="flex items-center justify-between gap-4 border-t border-[#173b3f]/8 py-3 text-sm font-semibold text-[#2e6f73]"
                    href={url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {label}
                    <Icon name="arrow" class="size-4" />
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-20">
      <h2 class="text-3xl font-semibold tracking-[-.035em] text-[#173b3f]">天氣、海象與生態資料</h2>
      <p class="section-lead mt-5">
        頁面上的即時天氣、多日預報、浪況與潮位，由本站伺服器取得後整理，並在伺服器端暫存以減少重複請求。天氣與海象數值為模式推估結果，官方警特報與潮汐表仍以主管機關公告為準。
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          [
            {
              title: '天氣預報',
              items: [
                ['天氣數值資料', 'Open-Meteo 氣象資料服務'],
                ['查詢座標', `${site.coordinates.latitude}, ${site.coordinates.longitude}（觀夕平台）`],
                ['暫存時間', '約 10 分鐘更新一次']
              ]
            },
            {
              title: '海象與氣候',
              items: [
                ['浪高、浪向與浪週期', 'Open-Meteo 海洋模式推估'],
                ['海水溫度', 'Open-Meteo 海洋模式推估'],
                ['潮位與漲退潮時間', '模式推估，僅供行程參考'],
                ['官方潮汐表與警特報', '中央氣象署'],
                ['區域觀光與活動公告', '臺南市政府、交通部觀光署']
              ]
            },
            {
              title: '生態與環境',
              items: [
                ['濕地與候鳥', '內政部國家公園署台江國家公園'],
                ['海岸與海洋環境', '海洋委員會、環境部'],
                ['海洋廢棄物與淨灘', '環境部、海洋委員會']
              ]
            },
            {
              title: '歷史與地名',
              items: [
                ['安平地方史與文化資產', '臺南市政府文化局、安平區公所'],
                ['臺灣史研究與館舍', '國立臺灣歷史博物館等官方館舍']
              ]
            }
          ].map((group) => (
            <div class="rounded-2xl border border-[#173b3f]/10 bg-white/60 p-6">
              <h3 class="font-semibold text-[#173b3f]">{group.title}</h3>
              <dl class="mt-4 flex flex-col">
                {group.items.map(([label, value]) => (
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-[#173b3f]/8 py-3">
                    <dt class="text-xs text-[#173b3f]/55">{label}</dt>
                    <dd class="text-sm font-semibold text-[#173b3f]">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
      <p class="mt-5 text-xs leading-7 text-[#173b3f]/55">
        正文以質性描述為主，涉及季節、生態與法規的敘述均採一般性原則；需要精確數值時，請查上述主管機關的最新公告與統計。
      </p>
    </section>

    <section class="mt-20">
      <h2 class="text-3xl font-semibold tracking-[-.035em] text-[#173b3f]">旅客評價與評分來源</h2>
      <p class="section-lead mt-5">
        本站只呈現評分與評價數量，不轉載個別評論文字，也不把評價寫入結構化資料（JSON-LD）。
      </p>
      <div class="mt-8 rounded-2xl border border-[#173b3f]/10 bg-white/60 p-6 sm:p-8">
        <div class="flex flex-wrap items-end gap-x-8 gap-y-4">
          <div>
            <p class="text-xs font-semibold tracking-[.16em] text-[#2e6f73]">評價 · 同步時間 {site.reviews.syncedAt}</p>
            <p class="mt-3 text-[2.4rem] font-semibold leading-none tracking-[-.05em] text-[#173b3f]">
              {site.reviews.ratingLabel}
              <span class="text-base font-semibold text-[#173b3f]/55">／5</span>
            </p>
          </div>
          <dl class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
            <div>
              <dt class="text-xs text-[#173b3f]/52">評價數量</dt>
              <dd class="mt-1 font-semibold text-[#173b3f]">{site.reviews.countLabel} 則</dd>
            </div>
            <div>
              <dt class="text-xs text-[#173b3f]/52">來源</dt>
              <dd class="mt-1 font-semibold text-[#173b3f]">{site.reviews.source}</dd>
            </div>
            <div>
              <dt class="text-xs text-[#173b3f]/52">景點類型</dt>
              <dd class="mt-1 font-semibold text-[#173b3f]">{site.placeType}</dd>
            </div>
          </dl>
        </div>
        <p class="mt-6 text-xs leading-7 text-[#173b3f]/58">{site.reviews.note}</p>
        <div class="mt-6 flex flex-col gap-3">
          <a
            class="inline-flex w-fit items-center gap-2 rounded-full bg-[#e98a4a] px-5 py-3 text-sm font-bold text-[#172a3a]"
            href={site.maps.share}
            target="_blank"
            rel="noreferrer"
          >
            <Icon name="map" class="size-4" />
            {site.reviews.cta}
          </a>
          <a
            class="text-xs leading-7 text-[#173b3f]/62 underline decoration-[#2e6f73]/25 underline-offset-4"
            href={site.maps.share}
            target="_blank"
            rel="noreferrer"
          >
            {site.reviews.inlineNote}
          </a>
        </div>
      </div>
    </section>

    <section class="mt-20">
      <h2 class="text-3xl font-semibold tracking-[-.035em] text-[#173b3f]">實景圖片授權</h2>
      <p class="section-lead mt-5">
        圖片取自 Wikimedia Commons，檔名統一為「地點-主題-細節-序號」格式；建置時由 Astro 產生適合裝置的 AVIF／WebP 尺寸並壓縮，版面可能使用不同比例裁切，但未改變照片內容。
      </p>
      <p class="mt-5 rounded-2xl border border-[#e98a4a]/35 bg-[#e98a4a]/10 px-5 py-4 text-sm font-semibold leading-7 text-[#173b3f]">
        {site.rights.photos}
      </p>
      <div class="mt-8 overflow-hidden rounded-2xl border border-[#173b3f]/10 bg-white/60">
        {
          photoCredits.map((credit) => (
            <a
              href={credit.url}
              target="_blank"
              rel="noreferrer"
              class="credit-row"
            >
              <span>
                <strong>{credit.file}</strong>
                <small>{credit.original} · {credit.use}</small>
              </span>
              <span class="text-right">
                <strong>{credit.author}</strong>
                <small>{credit.license}</small>
              </span>
              <Icon name="arrow" class="size-5 shrink-0 text-[#2e6f73]" />
            </a>
          ))
        }
      </div>
      <p class="mt-4 text-xs leading-7 text-[#173b3f]/55">
        社群分享圖（guanxipingtai-social-cover-1.jpg）由主視覺照片裁切壓縮產生，用於 Open Graph 與社群卡片，授權與主視覺相同。
      </p>
    </section>

    <section class="mt-16 rounded-2xl bg-[#173b3f] p-6 text-white sm:p-8">
      <h2 class="text-xl font-semibold">資訊異動時怎麼判斷</h2>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-white/62">
        停車、公車、洗手間、店家營業與海岸狀態都可能改變。來源有衝突時，以現場公告、管理單位與交通營運單位最新資訊為準；安全相關內容不以一般旅遊文章覆蓋警示。
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .credit-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid rgb(23 59 63 / 9%);
    color: #173b3f;
    transition: background 160ms ease;
  }

  .credit-row:last-child {
    border-bottom: 0;
  }

  .credit-row:hover {
    background: white;
  }

  .credit-row strong,
  .credit-row small {
    display: block;
  }

  .credit-row strong {
    font-size: .86rem;
  }

  .credit-row small {
    margin-top: .2rem;
    color: rgb(23 59 63 / 52%);
    font-size: .7rem;
  }

  @media (max-width: 640px) {
    .credit-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .credit-row > span:nth-child(2) {
      grid-column: 1;
      text-align: left;
    }

    .credit-row > svg {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
