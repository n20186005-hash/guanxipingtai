---
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MapActions from '../components/MapActions.astro';
import ReviewRating from '../components/ReviewRating.astro';
import SafetyAlert from '../components/SafetyAlert.astro';
import StatusNotice from '../components/StatusNotice.astro';
import WeatherCard from '../components/WeatherCard.astro';
import { faqItems, site } from '../data/site';
import heroImage from '../assets/images/guanxipingtai-hero-sunset-1.jpg';
import coastImage from '../assets/images/guanxipingtai-coast-platform-1.jpg';
import oldStreetImage from '../assets/images/anping-old-street-food-1.jpg';
import treeHouseImage from '../assets/images/anping-tree-house-banyan-1.jpg';
import foodImage from '../assets/images/anping-market-snack-1.jpg';

const address = site.addressParts;
const entityPath = [site.officialName, address.locality, address.region, address.country];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.fullName,
    alternateName: '觀夕平台',
    url: site.url,
    inLanguage: 'zh-Hant-TW',
    description: site.description
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': `${site.url}/#attraction`,
    name: site.officialName,
    alternateName: [site.name, `${address.locality} ${site.officialName}`, `${address.region} ${site.officialName}`],
    description: `${site.officialName}（${site.name}）位於${address.country}${address.region}${address.locality}，適合散步、看海、拍攝剪影與欣賞臺灣海峽夕陽的戶外觀景台。`,
    url: site.url,
    image: [`${site.url}/guanxipingtai-social-cover-1.jpg`],
    isAccessibleForFree: true,
    address: {
      '@type': 'PostalAddress',
      streetAddress: address.street,
      postalCode: address.postalCode,
      addressLocality: address.locality,
      addressRegion: address.region,
      addressCountry: address.countryCode
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.coordinates.latitude,
      longitude: site.coordinates.longitude
    },
    hasMap: site.maps.share,
    touristType: ['親子旅客', '情侶', '攝影旅客', '自由行旅客'],
    sameAs: [site.maps.share, site.maps.place, site.tourism.tainan]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '首頁',
        item: site.url
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.slice(0, 8).map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer
      }
    }))
  }
];

const quickCards = [
  {
    number: '01',
    title: '幾點到比較好？',
    text: '一般旅客可在日落前 45–60 分鐘抵達；週末、自駕或想拍完整光線變化，建議再提早一些。',
    href: '/best-time/',
    icon: 'sun' as const
  },
  {
    number: '02',
    title: '適合停留多久？',
    text: '單純賞夕約 60–90 分鐘；親子玩沙或攝影，可連同收拾與返程預留約 2 小時。',
    href: '/guide/',
    icon: 'clock' as const
  },
  {
    number: '03',
    title: '停車方便嗎？',
    text: '夕陽前後與假日較容易滿位。不要把導航時間當成抵達時間，另外保留找位與步行的緩衝。',
    href: '/transport-parking/',
    icon: 'car' as const
  },
  {
    number: '04',
    title: '可以下水嗎？',
    text: '不建議把此處當成海水浴場。即使海面平靜，也要留意離岸流、突發浪況與現場警示。',
    href: '/safety/',
    icon: 'shield' as const
  }
];

const activities = [
  { title: '等待夕陽', text: '看金色海面慢慢轉成晚霞。', icon: 'sun' as const },
  { title: '海岸散步', text: '沿平台、防風林與沙岸找自己的節奏。', icon: 'walk' as const },
  { title: '拍攝剪影', text: '人物、港灣與雲層都是構圖的一部分。', icon: 'sparkles' as const },
  { title: '親子玩沙', text: '留在乾沙區，與浪線保持安全距離。', icon: 'wave' as const }
];

const routes = [
  {
    duration: '60 MIN',
    title: '快速賞夕',
    steps: ['入口確認', '平台看海', '夕陽位置', '日落後返程']
  },
  {
    duration: '90 MIN',
    title: '第一次來最剛好',
    steps: ['提早抵達', '海岸散步', '黃金時刻', '晚霞']
  },
  {
    duration: '120 MIN',
    title: '親子或攝影',
    steps: ['熟悉環境', '玩沙取景', '日落', '藍調時刻']
  }
];

const deepDives = [
  {
    href: '/best-time/',
    eyebrow: 'SEASON GUIDE',
    title: '四季遊覽策略表',
    text: '把氣象、海象與生態放在同一張表對照：哪幾個月光線與體感最平衡，什麼時候海面最不平靜。',
    points: ['梅雨、颱風與東北季風的季節位置', '海溫與體感差異', '候鳥與潮間帶觀察重點'],
    icon: 'sun' as const
  },
  {
    href: '/itinerary/',
    eyebrow: 'BY TRAVELLER',
    title: '按人群定制的三條路線',
    text: '親子家庭、攝影自然、低體力與無障礙，三種節奏有不同的停留方式與注意事項。',
    points: ['親子：移動半徑要小、洗手間先安排', '攝影：日落前 90 分鐘進場到藍調', '無障礙：車輛直達、平台近端停留'],
    icon: 'walk' as const
  },
  {
    href: '/facilities/',
    eyebrow: 'VISITOR SERVICES',
    title: '訪客服務與周邊設施',
    text: '洗手間、停車、餐飲、住宿、採買、加油與充電的服務類型與查詢方式，只談類型不推薦店家。',
    points: ['洗手間與沖洗設施', '停車與回程動線', '飲水、垃圾與雨天備案'],
    icon: 'car' as const
  },
  {
    href: '/coast-science/',
    eyebrow: 'COASTAL SCIENCE',
    title: '海岸科普與訪客責任',
    text: '潮汐、離岸流、季風長浪、沙岸地形與海岸生態，以及無痕海岸的八個原則。',
    points: ['潮汐如何改變安全邊界', '離岸流的辨識與應對', '不踩踏沙丘與防風林'],
    icon: 'wave' as const
  }
];

const tripLengths = [
  {
    label: '半日',
    duration: '約 4–5 小時',
    summary: '歷史景點擇一，黃昏到海岸收尾。',
    detail: ['抵達安平 → 古堡或樹屋擇一 → 老街用餐', '往海岸移動並找車位', '日落前 1 小時抵達平台'],
    bestFor: '第一次來、行程較緊'
  },
  {
    label: '全日',
    duration: '約 8–9 小時',
    summary: '上午台江或港區，最曬的時段留在室內。',
    detail: ['上午台江國家公園或港灣地景', '中午室內午餐與休息', '午後老街古蹟 → 黃昏海岸 → 晚餐'],
    bestFor: '想完整走完安平'
  }
];
---

<BaseLayout structuredData={structuredData}>
  <section class="home-hero">
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      alt="觀夕平台（觀夕平臺）主視覺：臺南安平港北堤與臺灣海峽黃昏雲層"
      class="home-hero-picture"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="home-hero-overlay"></div>
    <div class="hero-sun" aria-hidden="true"></div>

    <div class="shell relative z-10 flex min-h-[min(780px,calc(100svh-72px))] flex-col justify-end pb-8 pt-20 sm:pb-12">
      <div class="max-w-4xl">
        <h1 class="hero-title">
          <span>觀夕平台</span>
          <small>觀夕平臺・臺南安平｜安平一天的最後一站</small>
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-white/76 sm:text-lg">
          歡迎來到觀夕平臺，也就是大家熟知的安平觀夕平台。在臺南市安平區的海岸線上散步、看海、等待夕陽落入臺灣海峽。先把交通、停車與回程想好，再把黃昏留給海風。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={site.maps.place}
            target="_blank"
            rel="noreferrer"
            class="button button-sunset"
          >
            <Icon name="map" class="size-5" />
            在 Google 地圖查看
          </a>
          <a
            href={site.maps.driving}
            target="_blank"
            rel="noreferrer"
            class="button button-light"
          >
            <Icon name="route" class="size-5" />
            規劃前往路線
          </a>
        </div>
      </div>

      <div class="hero-facts">
        <div>
          <span>建議停留</span>
          <strong>60–90 分鐘</strong>
        </div>
        <div>
          <span>推薦時段</span>
          <strong>日落前抵達</strong>
        </div>
        <div>
          <span>適合</span>
          <strong>散步・親子・攝影</strong>
        </div>
        <div>
          <span>行程定位</span>
          <strong>安平最後一站</strong>
        </div>
      </div>
    </div>
    <p class="photo-credit">
      安平港北堤夕景・Guanting Chen／CC BY-SA 4.0
    </p>
  </section>

  <section class="border-b border-[#173b3f]/10 bg-[#efe5d3]">
    <div class="shell flex flex-wrap items-center justify-center gap-x-8 gap-y-3 py-4 text-xs font-semibold text-[#173b3f]/64 sm:justify-between">
      <span class="inline-flex items-center gap-2"><Icon name="sun" class="size-4 text-[#e98a4a]" /> 日落前 45–60 分鐘抵達</span>
      <span class="inline-flex items-center gap-2"><Icon name="shield" class="size-4 text-[#e98a4a]" /> 不建議下水游泳</span>
      <span class="inline-flex items-center gap-2"><Icon name="car" class="size-4 text-[#e98a4a]" /> 假日提早找停車</span>
      <span class="inline-flex items-center gap-2"><Icon name="route" class="size-4 text-[#e98a4a]" /> 回程比去程更重要</span>
    </div>
  </section>

  <section class="weather-section py-16 sm:py-20">
    <div class="shell">
      <WeatherCard />
      <a class="sun-schedule-link" href="/sunset-time/">
        <span class="sun-schedule-icon"><Icon name="sun" class="size-5" /></span>
        <span class="sun-schedule-body">
          <strong>觀夕平台日落時間表</strong>
          <small>逐日列出日出、日落、日落方位與黃金時刻，含全年總覽與建議抵達時間</small>
        </span>
        <Icon name="arrow" class="size-5 shrink-0" />
      </a>
    </div>
  </section>

  <section class="pb-4 sm:pb-6">
    <div class="shell">
      <ReviewRating />
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="shell">
      <div class="grid items-end gap-6 md:grid-cols-[1fr_auto]">
        <div>
          <h2 class="section-title">出發前，先回答四個問題</h2>
        </div>
        <p class="section-lead md:max-w-sm">
          不用先讀完整本攻略。先把時間、停留、交通與海邊安全想清楚，就能做出適合今天的決定。
        </p>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {
          quickCards.map((card) => (
            <a href={card.href} class="quick-card group">
              <div class="flex items-center justify-between">
                <span class="quick-icon"><Icon name={card.icon} class="size-5" /></span>
                <span class="text-[.64rem] font-bold tracking-[.18em] text-[#173b3f]/25">{card.number}</span>
              </div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <span class="mt-auto inline-flex items-center gap-2 pt-5 text-xs font-bold text-[#2e6f73]">
                查看指南
                <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-white/55 py-20 sm:py-28">
    <div class="shell grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="coast-photo-wrap">
        <Image
          src={coastImage}
          alt="觀夕平台（觀夕平臺）海岸、沙灘與安平燈塔實景"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 52vw, 100vw"
          loading="lazy"
          decoding="async"
          quality={72}
          class="size-full object-cover"
        />
        <div class="coast-stamp">
          <Icon name="wave" class="size-7" />
          <span>海岸・平台・防風林</span>
        </div>
        <p class="image-credit">觀夕平台・ScoutT7／CC BY-SA 4.0</p>
      </div>

      <div>
        <h2 class="section-title">不是只看一顆太陽</h2>
        <p class="section-lead mt-5">
          觀夕平台的風景，來自港灣、海面、沙岸與人的共同變化。提早一點抵達，才有時間看見完整的黃昏。
        </p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            activities.map((item) => (
              <div class="activity-card">
                <Icon name={item.icon} class="size-5 text-[#e98a4a]" />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
        <a href="/guide/" class="text-link mt-7 inline-flex items-center gap-2">
          第一次來，現場怎麼走
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="route-section">
    <div class="route-glow" aria-hidden="true"></div>
    <div class="shell relative z-10 py-20 sm:py-28">
      <div class="grid items-end gap-6 md:grid-cols-[1fr_auto]">
        <div>
          <h2 class="section-title !text-white">把時間留給光線變化</h2>
        </div>
        <p class="max-w-md text-sm leading-7 text-white/58">
          三條路線沒有必走的打卡順序，依同行者、風勢與回程彈性選擇即可。
        </p>
      </div>

      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        {
          routes.map((route, index) => (
            <div class="route-card">
              <div class="flex items-start justify-between gap-4">
                <span class="route-duration">{route.duration}</span>
                <span class="route-index">0{index + 1}</span>
              </div>
              <h3>{route.title}</h3>
              <ol>
                {route.steps.map((step, stepIndex) => (
                  <li>
                    <span>{stepIndex + 1}</span>
                    {step}
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
      <a href="/guide/" class="mt-8 inline-flex items-center gap-2 text-sm font-bold text-[#f5ab78]">
        查看完整 60、90、120 分鐘路線
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="shell grid gap-12 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <h2 class="section-title">去程只是前半段</h2>
        <p class="section-lead mt-5">
          自駕要算停車，搭公車要看回程，叫車要先找好上車點。日落後再開始找路，往往比想像中慌亂。
        </p>
        <div class="mt-8">
          <MapActions />
        </div>
        <a href="/transport-parking/" class="text-link mt-7 inline-flex items-center gap-2">
          查看完整交通與停車指南
          <Icon name="arrow" class="size-4" />
        </a>
      </div>

      <div class="map-embed">
        <iframe
          src={site.maps.embed}
          title="觀夕平台 Google 地圖"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="pb-20 sm:pb-28">
    <div class="shell">
      <SafetyAlert />
    </div>
  </section>

  <section class="bg-[#eee3d0] py-20 sm:py-28">
    <div class="shell">
      <div class="grid items-end gap-6 md:grid-cols-[1fr_auto]">
        <div>
          <h2 class="section-title">白天讀安平，傍晚去看海</h2>
        </div>
        <a href="/nearby/" class="text-link inline-flex items-center gap-2">
          查看全部附近景點
          <Icon name="arrow" class="size-4" />
        </a>
      </div>

      <div class="nearby-grid mt-12">
        <a href="/nearby/#安平古堡與安平老街" class="nearby-card nearby-card-wide group">
          <Image
            src={oldStreetImage}
            alt="觀夕平台附近景點：安平古堡與安平老街古堡街的小吃店與街道"
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 66vw, 100vw"
            loading="lazy"
            decoding="async"
            quality={72}
            class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <span class="nearby-shade"></span>
          <div>
            <small>第一站・經典安平</small>
            <h3>安平古堡 × 老街</h3>
            <p>歷史、小吃與巷弄，最適合排在看夕陽之前。</p>
          </div>
          <span class="image-credit">Chongkian／CC BY-SA 4.0</span>
        </a>

        <a href="/nearby/#安平樹屋與德記洋行" class="nearby-card nearby-card-tall group">
          <Image
            src={treeHouseImage}
            alt="觀夕平台附近景點：安平樹屋內垂落的榕樹氣根與舊倉庫"
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 34vw, 100vw"
            loading="lazy"
            decoding="async"
            quality={72}
            class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <span class="nearby-shade"></span>
          <div>
            <small>樹根與時間</small>
            <h3>安平樹屋</h3>
            <p>在建築與榕樹之間，感受安平的另一種光影。</p>
          </div>
          <span class="image-credit">Sun Taro／CC BY-SA 2.0</span>
        </a>

        <a href="/food/" class="nearby-card nearby-card-food group">
          <Image
            src={foodImage}
            alt="觀夕平台附近美食：安平老街販售糕餅、蜜餞與傳統零食的攤位"
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 34vw, 100vw"
            loading="lazy"
            decoding="async"
            quality={72}
            class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <span class="nearby-shade"></span>
          <div>
            <small>夕陽前後</small>
            <h3>安平小吃與晚餐</h3>
            <p>白天吃老街，日落後找一碗熱湯。</p>
          </div>
          <span class="image-credit">Mx. Granger／CC0</span>
        </a>
      </div>
    </div>
  </section>

  <section class="entity-section py-20 sm:py-28" id="about">
    <div class="shell">
      <nav class="geo-breadcrumb" aria-label="地理歸屬層級">
        {
          entityPath.map((part, index) => (
            <>
              {index > 0 && <span class="geo-sep" aria-hidden="true">→</span>}
              <span>{part}</span>
            </>
          ))
        }
      </nav>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1.05fr_.95fr]">
        <div class="flex flex-col gap-9">
          <div>
            <h2 class="entity-heading">關於觀夕平台（About 觀夕平臺）</h2>
            <p class="entity-text">
              歡迎來到<strong>觀夕平臺</strong>，這裡就是旅客口中的<strong>安平觀夕平台</strong>。它位於<strong>臺灣</strong><strong>臺南市</strong><strong>安平區</strong>漁濱路的海岸線上，是安平港灣最主要的賞夕據點，也常被安排成安平一日行程的最後一站。
            </p>
          </div>

          <div>
            <h2 class="entity-heading">位置與前往方式：觀夕平台怎麼去（Location &amp; How to Visit）</h2>
            <p class="entity-text">
              自駕可直接以 Google 地圖導航，搭乘大眾運輸則建議先確認日落後的回程班次；黃昏熱門時段周邊停車較快滿位，建議提早抵達。
            </p>
            <div class="mt-5">
              <MapActions />
            </div>
          </div>

          <div>
            <h2 class="entity-heading">觀夕平台周邊地標（Landmarks &amp; Attractions Around）</h2>
            <p class="entity-text">
              安排觀夕平台行程時，可以順路探索周邊的歷史地標與景點，包括<strong>安平古堡與安平老街</strong>，以及<strong>安平樹屋與德記洋行</strong>；把需要門票與日光的景點排在白天，夕陽留給海岸。
            </p>
            <a href="/nearby/" class="text-link mt-4 inline-flex items-center gap-2">
              查看全部附近景點
              <Icon name="arrow" class="size-4" />
            </a>
          </div>

          <div>
            <h2 class="entity-heading">觀夕平台的歷史與意義（History &amp; Significance）</h2>
            <p class="entity-text">
              觀夕平台座落在安平港北側的海岸堤防旁，平台、防風林與沙灘形成層次分明的港灣地景，也因此成為臺南最熱門的西向賞夕地點之一。想深入了解安平港與海岸地景，可閱讀完整介紹。
            </p>
            <a href="/history-highlights/" class="text-link mt-4 inline-flex items-center gap-2">
              查看歷史與看點
              <Icon name="arrow" class="size-4" />
