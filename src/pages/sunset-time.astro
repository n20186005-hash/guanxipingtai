  <script>
    const card = document.querySelector('[data-sun-now]');
    if (card) {
      const todayKey = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Taipei' }).format(
        new Date()
      );
      const row = document.querySelector<HTMLElement>(
        `[data-sun-row][data-date="${todayKey}"]`
      );
      const setText = (selector: string, value?: string) => {
        const target = card.querySelector(selector);
        if (target && value) target.textContent = value;
      };

      if (row) {
        row.classList.add('is-today');
        setText('[data-sun-kicker]', '今天');
        setText('[data-sun-date]', row.dataset.dateLabel);
        setText('[data-sun-sunset]', row.dataset.sunset);
        setText('[data-sun-sunrise]', row.dataset.sunrise);
        setText('[data-sun-golden]', row.dataset.golden);
        setText('[data-sun-azimuth]', row.dataset.azimuthLabel);
        setText('[data-sun-arrive]', row.dataset.arrive);
      } else {
        setText('[data-sun-kicker]', '本頁資料已超出表格範圍');
        const note = card.querySelector('[data-sun-note]');
        if (note instanceof HTMLElement) note.hidden = false;
      }
    }
  </script>

